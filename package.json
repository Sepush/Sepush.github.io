{
  "name": "artea-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/prepare-pages.mjs",
    "preview": "react-router build && vite preview --outDir build/client",
    "preview:static": "vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc --noEmit",
    "fmt": "vp fmt --write .",
    "fmt:check": "vp fmt --check .",
    "lint": "oxlint . --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint . --type-aware --tsconfig ./tsconfig.json --fix"
  },
  "dependencies": {
    "@pika-lab/react": "0.0.1",
    "@react-router/dev": "8.5.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "isbot": "^5",
    "katex": "^0.16.45",
    "maplibre-gl": "^5.24.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-map-gl": "^8.1.1",
    "react-markdown": "^10.1.0",
    "react-router": "8.5.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.35",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@unocss/preset-attributify": "^66.13.0",
    "@unocss/preset-wind3": "^66.13.0",
    "@unocss/reset": "^66.13.0",
    "lint-staged": "^17.0.8",
    "oxlint": "1.70.0",
    "playwright": "^1.61.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "unocss": "^66.13.0",
    "vite": "^8.3.8",
    "vite-plus": "^0.2.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.9.0"
}
